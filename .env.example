# 本文件仅作字段清单。复制为 GLEANER_ROOT/.env 后填写（勿提交 git）。
# 由 gleaner_cli.py 读取；也可设系统/用户环境变量。

# --- Elsevier（els）官方 API Key ---
# 申请步骤见 docs/ELSEVIER_API.md
# Portal: https://dev.elsevier.com/   Create: https://dev.elsevier.com/apikey/manage
# 建议学校邮箱；禁止第三方 Key
ELSEVIER_API_KEY=your_elsevier_api_key_here
# 也可不写环境变量，把 key 单行写入：acq/data/.elsevier_key

# --- 超级鹰（cnki 验证码）---
# https://www.chaojiying.com/
CJY_USER=your_chaojiying_username
CJY_PASS=your_chaojiying_password
CJY_SOFTID=your_softid

# --- 可选：知网网络代理（默认直连）---
# 校园网或 VPN 可以直接访问时保持不配置；不自动读取系统代理。
# 只有确实运行了代理程序才启用下一行，PORT 必须换为其真实数字端口。
# ACQ_PROXY=http://127.0.0.1:PORT
# ACQ_HEADLESS=1
# ACQ_BROWSER_CHANNEL=msedge
# 仅第一次没有 cookies.json 时才允许冷启动（续批次不要设）：
# ACQ_ALLOW_COLD_LOGIN=1
