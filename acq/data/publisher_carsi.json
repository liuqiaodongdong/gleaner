{
  "sciencedirect": {
    "domains": ["sciencedirect.com", "elsevier.com"],
    "pdf_pattern": "",
    "needs_response_capture": true,
    "_note": "pdfft URL 需要 PII 而非 DOI，无法用 {doi} 拼接；依赖 response 监听或 click 兜底抓 PDF"
  },
  "springer": {
    "domains": ["link.springer.com", "springer.com"],
