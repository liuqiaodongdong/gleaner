  },
  "emerald": {
    "domains": ["emerald.com"],
    "pdf_pattern": "https://www.emerald.com/insight/content/doi/{doi}/full/pdf",
    "needs_response_capture": false
  },
  "ebsco": {
    "domains": ["ebscohost.com", "ebsco.com"],
    "pdf_pattern": "",
    "needs_response_capture": true
  },
  "proquest": {
    "domains": ["proquest.com"],
    "pdf_pattern": "",
    "needs_response_capture": true
  }
}
