# 复制为 .env 不会自动被程序读取；推荐直接写进 MCP 配置的 env，
# 或在系统/终端里 export / set。本文件仅作字段清单。

# --- Elsevier（els_collect 必需）---
# 申请：https://dev.elsevier.com/  Create API Key（建议学校邮箱）
ELSEVIER_API_KEY=your_elsevier_api_key_here
# 也可不写环境变量，把 key 单行写入：acq/data/.elsevier_key

# --- 超级鹰（cnki_collect 过验证码必需）---
# 注册：https://www.chaojiying.com/
CJY_USER=your_chaojiying_username
CJY_PASS=your_chaojiying_password
CJY_SOFTID=your_softid

# --- 可选：CNKI 浏览器代理（不设则读 Windows 系统代理）---
# ACQ_PROXY=http://127.0.0.1:10808
# ACQ_HEADLESS=1
# ACQ_BROWSER_CHANNEL=msedge
